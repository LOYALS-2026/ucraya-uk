---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/PostCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { messagesEn as m, format } from '../../../i18n';
import { getPosts, pillarsOf, pillarPath, type Pillar } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return pillarsOf(posts).map((p) => ({ params: { pillar: p.slug }, props: { pillar: p } }));
}
const { pillar } = Astro.props as { pillar: Pillar };
const all = await getPosts();
const posts = all.filter((p) => pillarsOf([p])[0].slug === pillar.slug);
const pillars = pillarsOf(all);
const title = format(m.blog.pillarTitle, { pillar: pillar.name });
const crumbs = [
  { name: m.blog.breadcrumb, path: '/blog/' },
  { name: pillar.name, path: pillarPath(pillar.slug) },
];
---
<Base locale="en" path={pillarPath(pillar.slug)} title={title} description={m.blog.pillarLead + ' ' + pillar.name + '.'} crumbs={crumbs}>
  <Breadcrumbs locale="en" crumbs={crumbs} />
  <PageHero h1={title} lead={m.blog.pillarLead} />
  <section class="section">
    <div class="wrap">
      <ul class="pill-list">
        <li><a href="/blog/">{m.blog.all}</a></li>
        {pillars.map((p) => <li><a href={pillarPath(p.slug)} aria-current={p.slug === pillar.slug ? 'page' : undefined}>{p.name}</a></li>)}
      </ul>
      <div class="grid-cards cols-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
  <CtaBand locale="en" />
</Base>
