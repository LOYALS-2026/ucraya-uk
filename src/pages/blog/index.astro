---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { messagesEn as m } from '../../i18n';
import { getPosts, pillarsOf, pillarPath } from '../../lib/blog';
const posts = await getPosts();
const pillars = pillarsOf(posts);
const crumbs = [{ name: m.blog.breadcrumb, path: '/blog/' }];
---
<Base locale="en" path="/blog/" title={m.meta.blog.title} description={m.meta.blog.description} crumbs={crumbs}>
  <Breadcrumbs locale="en" crumbs={crumbs} />
  <PageHero h1={m.blog.h1} lead={m.blog.lead} />
  <section class="section">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="notice">{m.blog.empty}</p>
      ) : (
        <>
          <h2 class="text-xl mb-3">{m.blog.filterTitle}</h2>
          <ul class="pill-list">
            <li><a href="/blog/" aria-current="page">{m.blog.all}</a></li>
            {pillars.map((p) => <li><a href={pillarPath(p.slug)}>{p.name}</a></li>)}
          </ul>
          <div class="grid-cards cols-3">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
        </>
      )}
    </div>
  </section>
  <CtaBand locale="en" />
</Base>
