---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import ProductCards from '../components/ProductCards.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import EnquireLink from '../components/EnquireLink.astro';
import Avatar from '../components/Avatar.astro';
import PostCard from '../components/PostCard.astro';
import { useMessages, format, type Locale } from '../i18n';
import { pathFor } from '../lib/routes';
import { pageMeta } from '../lib/page';
import { SITE } from '../lib/site';
import { organization, website } from '../lib/jsonld';
import { getPosts } from '../lib/blog';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = useMessages(locale);
const meta = pageMeta('home', locale);
const faqTeaser = m.faqPage.items.slice(0, 4);
const accents = ['accent-amber', 'accent-green', 'accent-orange', 'accent-navy', 'accent-amber', 'accent-green', 'accent-orange'];
const latest = (await getPosts()).slice(0, 3);
// The headline and the lead are split into words so each can rise in (CSS only, delays by position; no inline styles).
// The headline breaks in a fixed place (m.home.h1Lines) so no word is ever split across lines.
const h1Words = m.home.h1Lines.map((line) => line.split(' '));
const leadWords = m.home.lead.split(' ');
---
<Base locale={locale} routeId="home" title={meta.title} description={meta.description} jsonLd={[organization(), website()]} scripts={['/js/hero.js']}>
  <section class="hero">
    <div class="wrap">
      <div class="glass hero-panel">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">{m.site.since}</span>
          <h1 class="rise-words">{h1Words.map((line, li) => (<Fragment>{li > 0 && <br />}{line.map((w, wi) => (<Fragment>{li > 0 || wi > 0 ? ' ' : ''}<span class="rw">{w}</span></Fragment>))}</Fragment>))}</h1>
          <p class="lead rise-words">{leadWords.map((w, i) => (<Fragment>{i > 0 ? ' ' : ''}<span class="rw">{w}</span></Fragment>))}</p>
          <div class="btn-row mt-6 rise-late">
            <EnquireLink locale={locale} class="btn btn-primary">{m.buttons.enquire}</EnquireLink>
            <a class="btn btn-secondary" href={pathFor('trial', locale)}>{m.buttons.trial}</a>
          </div>
          <p class="rise-late"><a class="wa-link hero-wa" href={SITE.whatsapp} rel="noopener">{m.buttons.whatsapp}</a></p>
          <p class="muted mt-4 rise-late">{m.home.heroNote}</p>
        </div>
        <div class="art-wrap"><HeroArt locale={locale} /></div>
      </div>
      </div>
    </div>
  </section>

  <section class="proof-strip">
    <div class="wrap">
      <ul class="badge-row">
        <li><a href={SITE.googleReviews} rel="noopener">{m.common.ratedGoogle}</a></li>
        <li>{m.common.sinceProof}</li>
        <li>{m.common.tutorsProof}</li>
        <li>{m.common.facebookFollowers}</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{m.home.audience.title}</h2>
      <p class="lead mt-2 mb-8">{m.home.audience.intro}</p>
      <div class="grid-cards cols-4">
        {m.home.audience.items.map((a, i) => (
          <a class={`card card-link card-accent ${accents[i]}`} href={pathFor(`course-${a.slug}`, locale) + ('anchor' in a && a.anchor ? `#${a.anchor}` : '')}>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <p class="mt-3"><span class="more">{format(m.home.audience.linkFmt, { name: m.courses.items[a.slug].name })}</span></p>
          </a>
        ))}
        <a class="card card-link card-accent accent-navy price-card" href={pathFor('placement', locale)}>
          <h3>{m.home.audience.placement.title}</h3>
          <p>{m.home.audience.placement.text}</p>
          <p class="mt-3"><span class="more">{m.home.audience.placement.link}</span></p>
        </a>
      </div>
    </div>
  </section>

  <section class="section tq-strip" aria-labelledby="home-tq-h">
    <div class="wrap">
      <div class="card card-accent accent-green strip-card">
        <div>
          <h2 id="home-tq-h" class="text-xl">{m.home.translation.title}</h2>
          <p class="mt-2">{m.home.translation.text}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href={pathFor('translation', locale) + '#enquiry'}>{m.home.translation.link}</a>
          <a class="btn btn-secondary" href={pathFor('translation', locale)}>{m.home.translation.more}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-warm">
    <div class="wrap">
      <h2>{m.home.steps.title}</h2>
      <ol class="steps row mt-8">
        {m.home.steps.items.map((s) => (
          <li><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <p class="mt-8"><a class="btn btn-secondary" href={pathFor('how', locale)}>{m.buttons.howItWorks}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{m.home.prices.title}</h2>
      <p class="lead mt-2 mb-8">{m.home.prices.intro}</p>
      <ProductCards locale={locale} />
      <p class="mt-6">{m.home.prices.note}</p>
      <p class="mt-4"><a class="btn btn-secondary" href={pathFor('pricing', locale)}>{m.buttons.prices}</a></p>
    </div>
  </section>

  <section class="section section-warm">
    <div class="wrap">
      <h2>{m.home.proof.title}</h2>
      <p class="lead mt-2 mb-8">{m.home.proof.lead}</p>
      <div class="quote-strip" data-strip="home-reviews">
        <a class="card card-link card-accent accent-amber rating-card" href={SITE.googleReviews} rel="noopener">
          <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <p class="font-bold text-ink">{m.common.ratedGoogle}</p>
          <p><span class="more">{m.buttons.reviewOnGoogle}</span></p>
        </a>
        {m.reviews.items.slice(0, 3).map((r) => (
          <figure class="card quote quote-card">
            <blockquote>&ldquo;{r.quote}&rdquo;</blockquote>
            <figcaption>{r.name}{r.context && <span class="ctx">{r.context}</span>}</figcaption>
          </figure>
        ))}
      </div>
      <ul class="dots" data-dots="home-reviews" data-label={m.common.quoteOf}></ul>
      <div class="btn-row mt-8">
        <a class="btn btn-secondary" href={pathFor('reviews', locale)}>{m.buttons.allReviews}</a>
        <a class="btn btn-secondary" href={SITE.googleReviews} rel="noopener">{m.buttons.reviewOnGoogle}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{m.home.tutors.title}</h2>
      <p class="mt-3 mb-6 max-w-2xl">{m.home.tutors.text}</p>
      <ul class="tutor-row">
        {m.tutors.items.slice(0, 4).map((t, i) => (
          <li class="card glass tutor-mini">
            <Avatar name={t.name} index={i} />
            <div><h3>{t.name}</h3><p>{t.text}</p></div>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a class="btn btn-secondary" href={pathFor('tutors', locale)}>{m.buttons.tutors}</a></p>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>{m.home.guides.title}</h2>
        <p class="lead mt-2 mb-8">{m.home.guides.lead}</p>
        <div class="grid-cards cols-3">{latest.map((p) => <PostCard post={p} />)}</div>
        <div class="btn-row mt-8">
          <a class="btn btn-secondary" href="/blog/">{m.home.guides.all}</a>
          <a class="btn btn-secondary" href="/blog/questions/">{m.home.guides.questions}</a>
        </div>
      </div>
    </section>
  )}

  <section class="section section-warm">
    <div class="wrap narrow">
      <h2 class="mb-6">{m.home.faq.title}</h2>
      <FaqList items={faqTeaser} />
      <p class="mt-6"><a class="btn btn-secondary" href={pathFor('faq', locale)}>{m.buttons.allFaq}</a></p>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
