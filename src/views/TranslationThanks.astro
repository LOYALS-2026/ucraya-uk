---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { useMessages, type Locale } from '../i18n';
import { pathFor } from '../lib/routes';
import { pageMeta } from '../lib/page';
import { SITE } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const m = useMessages(locale);
const t = m.translation.thanks;
const meta = pageMeta('translation-thanks', locale);
const ld = [{ '@context': 'https://schema.org', '@type': 'WebPage', name: t.h1, inLanguage: locale }];
---
<Base locale={locale} routeId="translation-thanks" title={meta.title} description={meta.description} noindex jsonLd={ld}>
  <PageHero h1={t.h1} lead={t.lead}>
    <div class="btn-row mt-6">
      <a class="btn btn-whatsapp" href={SITE.whatsapp} rel="noopener">{m.buttons.whatsapp}</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="wrap narrow">
      <h2>{t.next}</h2>
      <ul class="tick-list mt-4">{t.items.map((i) => <li>{i}</li>)}</ul>
      <div class="btn-row mt-6">
        <a class="btn btn-secondary" href={pathFor('translation', locale)}>{m.translation.buttons.back}</a>
        <a class="btn btn-secondary" href={pathFor('how', locale)}>{m.buttons.howItWorks}</a>
        <a class="btn btn-secondary" href={pathFor('pricing', locale)}>{m.buttons.prices}</a>
      </div>
    </div>
  </section>
</Base>
