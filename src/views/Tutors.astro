---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import Avatar from '../components/Avatar.astro';
import CtaBand from '../components/CtaBand.astro';
import { useMessages, type Locale } from '../i18n';
import { pathFor } from '../lib/routes';
import { pageMeta } from '../lib/page';
interface Props { locale: Locale }
const { locale } = Astro.props;
const m = useMessages(locale);
const t = m.tutors;
const meta = pageMeta('tutors', locale);
const crumbs = [{ name: m.nav.tutors, path: pathFor('tutors', locale) }];
---
<Base locale={locale} routeId="tutors" title={meta.title} description={meta.description} crumbs={crumbs}>
  <Breadcrumbs locale={locale} crumbs={crumbs} />
  <PageHero h1={t.h1} lead={t.lead} />
  <section class="section">
    <div class="wrap">
      <p class="max-w-3xl mb-8">{t.intro}</p>
      <ul class="grid-cards cols-3 list-none p-0">
        {t.items.map((p, i) => (
          <li class="card person">
            <Avatar name={p.name} index={i} />
            <div>
              <h2 class="text-lg">{p.name}</h2>
              {p.role && <p class="font-bold text-ink">{p.role}</p>}
              <p class="mt-1">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section section-warm">
    <div class="wrap narrow">
      <h2>{t.lessonsTitle}</h2>
      <p class="mt-3">{t.lessonsText}</p>
    </div>
  </section>
  <CtaBand locale={locale} />
</Base>
