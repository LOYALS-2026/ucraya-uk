---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { useMessages, type Locale } from '../i18n';
import { pathFor } from '../lib/routes';
import { pageMeta } from '../lib/page';
interface Props { locale: Locale }
const { locale } = Astro.props;
const m = useMessages(locale);
const meta = pageMeta('how', locale);
const crumbs = [{ name: m.nav.how, path: pathFor('how', locale) }];
---
<Base locale={locale} routeId="how" title={meta.title} description={meta.description} crumbs={crumbs}>
  <Breadcrumbs locale={locale} crumbs={crumbs} />
  <PageHero h1={m.how.h1} lead={m.how.lead} />
  <section class="section">
    <div class="wrap narrow">
      <ol class="steps">
        {m.how.steps.map((s) => (
          <li><h2 class="text-xl">{s.title}</h2><p>{s.text}</p></li>
        ))}
      </ol>
      <div class="btn-row mt-10">
        <a class="btn btn-primary" href={pathFor('contact', locale) + '#enquiry'}>{m.buttons.enquire}</a>
        <a class="btn btn-outline" href={pathFor('placement', locale)}>{m.buttons.placement}</a>
        <a class="btn btn-outline" href={pathFor('pricing', locale)}>{m.buttons.prices}</a>
      </div>
    </div>
  </section>
  <CtaBand locale={locale} title={m.how.cta} />
</Base>
