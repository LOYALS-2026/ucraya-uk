---
import '../styles/global.css';

import { htmlLang, useMessages, locales, type Locale } from '../i18n';
import { SITE, OG_LOCALES } from '../lib/site';
import { route, localePath, absolute } from '../lib/routes';
import { seoTitle, seoDescription, jsonForScript } from '../lib/seo';
import { breadcrumbList, webPage } from '../lib/jsonld';
import ptSans400 from '@fontsource/pt-sans/files/pt-sans-latin-400-normal.woff2?url';
import robotoSlab700 from '@fontsource/roboto-slab/files/roboto-slab-latin-700-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyBar from '../components/StickyBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import EnquiryModal from '../components/EnquiryModal.astro';

export interface Props {
  locale: Locale;
  /** Route id for locale pages. Blog pages pass `path` instead. */
  routeId?: string;
  /** Typed first message for the WhatsApp links in the sticky bar. */
  whatsappText?: string;
  /** Path (English, with slashes) for pages that are not in the route table. */
  path?: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
  crumbs?: { name: string; path: string }[];
  ogType?: string;
  scripts?: string[];
  /** Prefill for the Enquire buttons in the header and the phone bar (goal, format, level, purpose slugs). */
  enquire?: { goal?: string; format?: string; level?: string; purpose?: string };
}

const { locale, routeId, whatsappText, path, title, description, noindex = false, jsonLd = [], crumbs = [], ogType = 'website', scripts = [], enquire = {} } = Astro.props;
const m = useMessages(locale);

let canonicalPath: string;
let alternates: { hreflang: string; href: string }[] = [];
let switchLinks: Record<string, string> = {};
let pageLocales: readonly Locale[] = ['en'];

if (routeId) {
  const r = route(routeId);
  pageLocales = r.locales;
  canonicalPath = localePath(locale, r.path);
  for (const l of r.locales) alternates.push({ hreflang: l, href: absolute(localePath(l, r.path)) });
  alternates.push({ hreflang: 'x-default', href: absolute(localePath('en', r.path)) });
  for (const l of locales) switchLinks[l] = r.locales.includes(l) ? localePath(l, r.path) : localePath(l, '/');
} else {
  canonicalPath = path ?? '/';
  alternates = [
    { hreflang: 'en', href: absolute(canonicalPath) },
    { hreflang: 'x-default', href: absolute(canonicalPath) },
  ];
  for (const l of locales) switchLinks[l] = l === 'en' ? canonicalPath : localePath(l, '/');
}

const canonical = absolute(canonicalPath);
const isNotFound = canonicalPath === '/404.html';
// On the contact and free trial pages the inline form IS the page, so Enquire scrolls to it. Everywhere else it opens the pop-in.
const inline = routeId === 'contact' || routeId === 'trial';
const fullTitle = seoTitle(title);
const desc = seoDescription(description);
const ogImage = absolute('/og/default.png');

const crumbList = crumbs.length
  ? [{ name: m.common.home, url: absolute(localePath(locale, '/')) }, ...crumbs.map((c) => ({ name: c.name, url: absolute(c.path) }))]
  : [];
// Every money page carries a WebPage (or About/Contact page) with speakable on the h1 and the first paragraph.
const PAGE_TYPES = ['WebPage', 'AboutPage', 'ContactPage'];
const hasPage = jsonLd.some((d: any) => PAGE_TYPES.includes(d['@type']));
const pageLd = routeId && !noindex && !hasPage ? [webPage({ url: canonical, name: fullTitle, description: desc, locale: htmlLang[locale] })] : [];
const allJsonLd = [...jsonLd, ...pageLd, ...(crumbList.length ? [breadcrumbList(crumbList)] : [])];
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!isNotFound && <link rel="canonical" href={canonical} />}
    {!isNotFound && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#fbf8f2" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={ptSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={robotoSlab700} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.site.strap} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="Ucraya guides" href="/rss.xml" />
    {allJsonLd.map((d) => <script type="application/ld+json" set:html={jsonForScript(d)} />)}
  </head>
  <body>
    <div class="mesh" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <a class="skip-link" href="#main">{m.site.skip}</a>
    <SiteHeader locale={locale} switchLinks={switchLinks} currentRoute={routeId} currentPath={canonicalPath} inline={inline} enquire={enquire} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <StickyBar locale={locale} inline={inline} enquire={enquire} whatsappText={whatsappText} />
    <button class="to-top" type="button" data-to-top aria-label={m.common.backToTop}>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 12l6-6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>
    <EnquiryModal locale={locale} />
    {SITE.gaId && <CookieBanner locale={locale} />}
    <script src="/js/nav.js" defer></script>
    <script src="/js/lang.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/attribution.js" defer></script>
    <script src="/js/form.js" defer></script>
    {scripts.map((s) => <script src={s} defer></script>)}
  </body>
</html>
