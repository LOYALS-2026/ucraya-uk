---
import { useMessages, type Locale } from '../i18n';
import { pathFor } from '../lib/routes';
import { SITE } from '../lib/site';
import EnquireLink from './EnquireLink.astro';
interface Props { locale: Locale; title?: string; text?: string; goal?: string; trial?: boolean }
const { locale, title, text, goal, trial = true } = Astro.props;
const m = useMessages(locale);
---
<section class="section">
  <div class="wrap">
    <div class="cta-panel">
      <h2>{title ?? m.home.final.title}</h2>
      <p class="mt-3 mb-6 max-w-2xl text-lg">{text ?? m.home.final.text}</p>
      <div class="btn-row">
        <EnquireLink locale={locale} class="btn btn-primary" goal={goal}>{m.buttons.enquire}</EnquireLink>
        {trial && <a class="btn btn-secondary" href={pathFor('trial', locale)}>{m.buttons.trial}</a>}
        <a class="btn btn-secondary" href={SITE.whatsapp} rel="noopener">{m.buttons.whatsapp}</a>
      </div>
    </div>
  </div>
</section>
