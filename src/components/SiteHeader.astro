---
import { useMessages, localeNames, locales, type Locale } from '../i18n';
import { pathFor, localePath } from '../lib/routes';
import EnquireLink from './EnquireLink.astro';

interface Props {
  locale: Locale;
  switchLinks: Record<string, string>;
  currentRoute?: string;
  currentPath: string;
  /** Page has its own inline enquiry form (contact, free trial): the Enquire button scrolls to it. */
  inline?: boolean;
  enquire?: { goal?: string; format?: string; level?: string; purpose?: string };
}
const { locale, switchLinks, currentRoute, currentPath, inline = false, enquire = {} } = Astro.props;
const m = useMessages(locale);
const items = [
  { id: 'courses', label: m.nav.courses, href: pathFor('courses', locale), match: (r?: string) => r === 'courses' || (r ?? '').startsWith('course-') },
  { id: 'pricing', label: m.nav.pricing, href: pathFor('pricing', locale) },
  { id: 'how', label: m.nav.how, href: pathFor('how', locale) },
  { id: 'tutors', label: m.nav.tutors, href: pathFor('tutors', locale) },
  { id: 'reviews', label: m.nav.reviews, href: pathFor('reviews', locale) },
  { id: 'faq', label: m.nav.faq, href: pathFor('faq', locale) },
  { id: 'blog', label: m.nav.blog, href: '/blog/' },
  { id: 'contact', label: m.nav.contact, href: pathFor('contact', locale) },
];
const isCurrent = (it: (typeof items)[number]) =>
  it.match ? it.match(currentRoute) : it.id === currentRoute || (it.id === 'blog' && currentPath.startsWith('/blog'));
---
<header class="site-header glass-bar" data-open="false">
  <div class="wrap">
    <div class="header-bar">
      <a class="logo-link" href={localePath(locale, '/')} aria-label={m.header.homeLabel}>
        <img src="/raya/raya-compact-light.svg" width="536" height="220" alt="" />
      </a>
      <div class="nav-panel" id="nav-panel">
        <nav aria-label={m.header.mainNav}>
          <ul class="nav-list">
            {items.map((it) => (
              <li><a href={it.href} aria-current={isCurrent(it) ? 'page' : undefined}>{it.label}</a></li>
            ))}
          </ul>
        </nav>
        <ul class="panel-lang" aria-label={m.header.language}>
          {locales.map((l) => (
            <li>
              <a href={switchLinks[l]} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>
                <img class="flag" src={`/brand/flags/${l === 'en' ? 'gb' : l}.svg`} width="30" height="20" alt="" loading="lazy" />{localeNames[l]}
              </a>
            </li>
          ))}
        </ul>
        <EnquireLink locale={locale} class="btn btn-primary nav-cta-panel" inline={inline} {...enquire}>{m.buttons.enquireShort}</EnquireLink>
      </div>
      <details class="lang" data-lang>
        <summary aria-label={`${m.header.language}: ${localeNames[locale]}`} aria-controls="lang-menu">
          <img class="flag" src={`/brand/flags/${locale === 'en' ? 'gb' : locale}.svg`} width="30" height="20" alt="" />
          <span class="lang-code" aria-hidden="true">{locale.toUpperCase()}</span>
        </summary>
        <ul class="lang-menu" id="lang-menu">
          {locales.map((l) => (
            <li>
              <a href={switchLinks[l]} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>
                <img class="flag" src={`/brand/flags/${l === 'en' ? 'gb' : l}.svg`} width="30" height="20" alt="" loading="lazy" />
                <span>{localeNames[l]}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <EnquireLink locale={locale} class="btn btn-primary nav-cta-bar" inline={inline} {...enquire}>{m.buttons.enquireShort}</EnquireLink>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-panel" data-menu-btn
        data-open-label={m.header.menu} data-close-label={m.header.closeMenu}>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path class="ic-burger" d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><path class="ic-x" d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
        <span data-menu-label>{m.header.menu}</span>
      </button>
    </div>
  </div>
</header>
