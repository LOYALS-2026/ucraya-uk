---
interface Props { eyebrow?: string; h1: string; lead?: string }
const { eyebrow, h1, lead } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <div class="glass hero-panel">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{h1}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
