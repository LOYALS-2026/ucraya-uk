---
// The ONE Netlify form "enquiry". Rendered twice: inline (contact page, free trial, course pages) and inside the pop-in
// (EnquiryModal, on every page). Both copies have identical field names. public/js/form.js does validation and prefill;
// public/js/attribution.js fills the hidden "where did this enquiry come from" fields.
import { useMessages, messagesEn, type Locale } from '../i18n';
import { pathFor } from '../lib/routes';
import { SITE } from '../lib/site';

interface Props {
  locale: Locale;
  variant?: 'inline' | 'modal';
  goal?: string;
  format?: string;
  purpose?: 'enquiry' | 'trial' | 'placement';
  title?: string;
  headingLevel?: 'h2' | 'h3';
  intro?: boolean;
}
const { locale, variant = 'inline', goal, format: fmt, purpose = 'enquiry', title, headingLevel = 'h2', intro = true } = Astro.props;
const modal = variant === 'modal';
const p = modal ? 'm' : 'f';
const m = useMessages(locale);
const f = m.form;
const en = messagesEn.form;
const action = pathFor('thanks', locale);
const Heading = headingLevel;
const privacy = pathFor('privacy', locale);
const [tickBefore, tickAfter] = f.consentTick.split('{privacyLink}');
const levels: Record<string, string> = {};
for (const l of en.levels) levels[l.slug] = l.label;
const goalChecked = goal === 'staff' ? 'interview' : goal;
const e = f.errors;
---
<div class={modal ? 'contents' : 'form-card'} id={modal ? undefined : 'enquiry'}>
{!modal && <Heading>{title ?? f.title}</Heading>}
{!modal && intro && <p class="mt-2 mb-5">{f.intro}</p>}
<form
  name="enquiry"
  id={modal ? 'enquiry-form-modal' : 'enquiry-form'}
  class={modal ? 'enq-modal' : 'enq-inline'}
  method="POST"
  action={action}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-enquiry={variant}
  data-levels={JSON.stringify(levels)}
  data-err-email={e.email}
  data-err-name={e.name}
  data-err-phone={e.phone}
  data-err-goal={e.goal}
  data-err-consent={e.consent}
>
  <input type="hidden" name="form-name" value="enquiry" />
  <input type="hidden" name="subject" value="New enquiry from %{formName}: ucraya.uk" />
  <input type="hidden" name="purpose" value={purpose} />
  <input type="hidden" name="level" value={en.levels[0].label} />
  <input type="hidden" name="first-language" value="" />
  <input type="hidden" name="deadline" value="" />
  <input type="hidden" name="preferred-times" value="" />
  <input type="hidden" name="detail" value={goal === 'staff' ? 'Employer: ' + en.goals.find((g) => g.slug === 'staff')?.label : ''} />
  <input type="hidden" name="enquiry_page" value={Astro.url.pathname} />
  <input type="hidden" name="site_language" value={locale} />
  <input type="hidden" name="source_channel" value="" />
  <input type="hidden" name="source_referrer" value="" />
  <input type="hidden" name="landing_page" value="" />
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="device" value="" />
  <input type="hidden" name="browser_language" value="" />
  <input type="hidden" name="placement_level" value="" />
  <input type="hidden" name="visit_started" value="" />

  <div class={modal ? 'modal-body' : undefined}>
    <p class="form-note" data-note="trial" hidden={purpose !== 'trial'}>{f.trialNote}</p>
    <p class="form-note" data-note="placement" hidden={purpose !== 'placement'}>{f.placementNote}</p>

    <div class="enq-grid">
      <div class="field f-email">
        <label for={`${p}-email`}>{f.email} <span class="req" aria-hidden="true">*</span></label>
        <input class="input" id={`${p}-email`} type="email" name="email" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" required />
        <p class="err" id={`${p}-err-email`} hidden></p>
      </div>
      <div class="field f-name">
        <label for={`${p}-name`}>{f.name} <span class="req" aria-hidden="true">*</span></label>
        <input class="input" id={`${p}-name`} type="text" name="name" autocomplete="name" autocapitalize="words" spellcheck="false" enterkeyhint="next" required />
        <p class="err" id={`${p}-err-name`} hidden></p>
      </div>
      <div class="field f-phone">
        <label for={`${p}-phone`}>{f.phoneShort} <span class="opt">{f.optional}</span></label>
        <input class="input" id={`${p}-phone`} type="tel" name="phone" autocomplete="tel" inputmode="tel" spellcheck="false" enterkeyhint="next" />
        <p class="err" id={`${p}-err-phone`} hidden></p>
      </div>
    </div>

    <fieldset class="field" data-group="goal">
      <legend>{f.goal} <span class="req" aria-hidden="true">*</span></legend>
      <div class="chip-row">
        {f.chipGoals.map((g, i) => (
          <label class="chip"><input type="radio" name="goal" value={en.chipGoals[i].send} data-slug={g.slug} checked={g.slug === goalChecked} required /><span>{g.label}</span></label>
        ))}
      </div>
      <p class="err" id={`${p}-err-goal`} hidden></p>
    </fieldset>

    <fieldset class="field" data-group="format">
      <legend>{f.format}</legend>
      <div class="chip-row">
        {f.chipFormats.map((g, i) => (
          <label class="chip"><input type="radio" name="format" value={en.formats[i].label} data-slug={g.slug} checked={g.slug === (fmt ?? 'not-sure')} /><span>{g.label}</span></label>
        ))}
      </div>
    </fieldset>

    <div class="field">
      <label for={`${p}-message`}>{f.messageShort} <span class="opt">{f.optional}</span></label>
      <textarea class="input" id={`${p}-message`} name="message" rows={modal ? 2 : 4} autocomplete="off" enterkeyhint="enter"></textarea>
    </div>

    <p class="hp" aria-hidden="true">
      <label>{f.honeypot} <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="field">
      <label class="tick" for={`${p}-consent`}>
        <input id={`${p}-consent`} type="checkbox" name="consent" value="yes" required />
        <span>{tickBefore}<a href={privacy} target="_blank" rel="noopener">{f.privacyLinkText}</a>{tickAfter}</span>
      </label>
      <p class="err" id={`${p}-err-consent`} hidden></p>
    </div>
    {!modal && <p class="hint mb-3">{f.requiredNote}</p>}
  </div>

  {modal ? (
    <div class="modal-foot">
      <button type="submit" class="btn btn-primary btn-block" data-submit data-sending={f.sending}>{m.buttons.send}</button>
      <a class="wa-link" href={SITE.whatsapp} rel="noopener">{f.preferWhatsapp}</a>
    </div>
  ) : (
    <>
      <div class="btn-row">
        <button type="submit" class="btn btn-primary" data-submit data-sending={f.sending}>{m.buttons.send}</button>
        <a class="btn btn-secondary" href={SITE.whatsapp} rel="noopener">{m.buttons.whatsapp}</a>
      </div>
      <p class="hint mt-3">{f.reply}</p>
      <noscript><p class="hint">{f.noscript}</p></noscript>
    </>
  )}
</form>
</div>
