---
import { formatDate, postPath, type Post } from '../lib/blog';
import { messagesEn } from '../i18n';
interface Props { post: Post }
const { post } = Astro.props;
const m = messagesEn;
---
<a class="card card-link card-accent accent-amber" href={postPath(post.id)}>
  <p class="muted text-sm">{post.data.pillar}</p>
  <h2 class="text-xl mt-1">{post.data.title}</h2>
  <p class="mt-2">{post.data.description}</p>
  <p class="mt-3 text-sm muted">{formatDate(post.data.pubDate)}</p>
  <p class="mt-2"><span class="more">{m.blog.read}</span></p>
</a>
