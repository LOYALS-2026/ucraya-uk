---
import { useMessages, type Locale } from '../i18n';
import EnquireLink from './EnquireLink.astro';
interface Props { locale: Locale; compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { locale, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const m = useMessages(locale);
const p = m.products;
// The first card is the headline product: it gets the green glow. No claim is made in words.
const cards = [
  { ...p.oneToOne, accent: 'accent-green', fmt: 'one-to-one', glow: 'glow-green' },
  { ...p.oneToOneEnglish, accent: 'accent-amber', fmt: 'one-to-one', glow: 'glow-amber' },
  { ...p.group, accent: 'accent-orange', fmt: 'group', glow: '' },
  { ...p.exam, accent: 'accent-navy', fmt: 'not-sure', glow: '' },
];
---
<div class="grid-cards cols-4">
  {cards.map((c) => (
    <div class={`card card-accent price-card ${c.accent} ${c.glow}`}>
      <H class={headingLevel === 'h2' ? 'h3-like' : undefined}>{c.name}</H>
      <p class="price mt-3">{c.price}<small>{c.unit}</small></p>
      <p class="mt-3">{c.text}</p>
      <p class="mt-3"><EnquireLink locale={locale} format={c.fmt}>{m.buttons.askAbout}</EnquireLink></p>
    </div>
  ))}
</div>
