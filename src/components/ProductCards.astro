---
import { useMessages, type Locale } from '../i18n';
interface Props { locale: Locale; compact?: boolean }
const { locale } = Astro.props;
const m = useMessages(locale);
const p = m.products;
const cards = [
  { ...p.oneToOne, accent: 'accent-amber' },
  { ...p.oneToOneEnglish, accent: 'accent-green' },
  { ...p.group, accent: 'accent-orange' },
  { ...p.exam, accent: 'accent-navy' },
];
---
<div class="grid-cards cols-4">
  {cards.map((c) => (
    <div class={`card card-accent ${c.accent}`}>
      <h3>{c.name}</h3>
      <p class="price mt-3">{c.price}<small>{c.unit}</small></p>
      <p class="mt-3">{c.text}</p>
    </div>
  ))}
</div>
