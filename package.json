{
  "name": "ucraya-uk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "node scripts/check-site.mjs",
    "check:articles": "node scripts/articles/check.mjs",
    "article:next": "node scripts/articles/next.mjs",
    "article:publish": "node scripts/articles/mark-published.mjs",
    "article:skip": "node scripts/articles/skip.mjs",
    "article:summary": "node scripts/articles/batch-summary.mjs",
    "article:schedule": "node scripts/articles/schedule.mjs",
    "test:articles": "node scripts/articles/test.mjs",
    "shots": "node scripts/shots.mjs",
    "brand": "node scripts/gen-brand.mjs",
    "build:blog": "astro build --outDir .tmp/dist-blog && pagefind --site .tmp/dist-blog",
    "check:ui": "node scripts/ui-checks.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "csv-parse": "^7.0.3",
    "gray-matter": "^4.0.3",
    "opentype.js": "^2.0.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
